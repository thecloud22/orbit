# Orbit local development environment.
#
# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored. This file must never contain real secrets.

NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
#
# Host port 55432 is deliberate: it avoids colliding with a PostgreSQL server
# already listening on the default port 5432 on the development machine.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=orbit
POSTGRES_USER=orbit
# Local throwaway development credential for the containerised database only.
# This is not a secret and must never be reused outside local development.
POSTGRES_PASSWORD=orbit_local_dev
DATABASE_URL=postgresql://orbit:orbit_local_dev@localhost:55432/orbit

# -----------------------------------------------------------------------------
# Application ports
# -----------------------------------------------------------------------------
WEB_PORT=3000
DEMO_PORTAL_PORT=3001
API_PORT=3002
API_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Local artifact storage (implemented in Task 5). Gitignored.
# -----------------------------------------------------------------------------
ARTIFACT_STORAGE_DIR=./data/artifacts
