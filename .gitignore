# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
.vite/

# Test and coverage output
coverage/
playwright-report/
test-results/

# Local runtime data (artifact bytes: screenshots, DOM snapshots, traces).
# Anchored to the repo root so it cannot swallow source directories named
# "data" inside apps or packages.
/data/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
pnpm-debug.log*
# Full suite output, written by the heavy Vitest projects so a failure is never
# only in a scrollback buffer. See README > Validation commands.
/logs/

# OS
.DS_Store
