{
  "name": "orbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @orbit/demo-portal test:e2e",
    "test:e2e:library": "pnpm --filter @orbit/library-portal test:e2e",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "pnpm --filter @orbit/db migrate",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:db",
    "db:generate": "pnpm --filter @orbit/db generate",
    "db:seed": "pnpm --filter @orbit/db seed",
    "db:seed:library": "pnpm --filter @orbit/api seed:library",
    "agent:run": "pnpm --filter @orbit/browser-worker agent:run",
    "record:binding": "pnpm --filter @orbit/recorder record",
    "record:workflow": "pnpm --filter @orbit/recorder record-workflow",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:e2e:watchtower": "vitest run --config vitest.e2e.config.ts",
    "check:teardown": "node scripts/check-teardown.mjs",
    "verify:phase1": "pnpm verify && pnpm test:runtime && pnpm test:e2e:watchtower && pnpm test:e2e && pnpm check:teardown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
